# Environment & Application
ENVIRONMENT=development
DEBUG=true

# Database (Defaulting to local SQLite orbit.db for offline testing)
DATABASE_URL=sqlite+aiosqlite:///orbit.db
REDIS_URL=redis://localhost:6379/0

# External AI / Featherless.ai Keys
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_MODEL=gpt-4o-mini

# Caspian SDK Gateway Configuration
CASPIAN_API_KEY=your_caspian_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_WEBHOOK_SECRET=your_caspian_webhook_secret_here

# Channel Connection IDs (from running: caspian connect <channel>)
CASPIAN_TELEGRAM_CONNECTION_ID=your_telegram_connection_id_here
CASPIAN_EMAIL_CONNECTION_ID=your_email_connection_id_here
CASPIAN_SLACK_CONNECTION_ID=your_slack_connection_id_here
CASPIAN_DISCORD_CONNECTION_ID=your_discord_connection_id_here

# PDR Manager Telegram Conversation ID
ORBIT_MANAGER_CONVERSATION_ID=your_manager_conversation_id_here
